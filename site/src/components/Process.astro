---
import { process } from '../data/site';
---

<section class="section proc" id="proceso" aria-labelledby="proc-h">
  <div class="shell">
    <header class="section-head">
      <div>
        <p class="eyebrow reveal" data-reveal="fade">Proceso de trabajo</p>
        <h2 id="proc-h" class="display proc__h">
          <span class="line"><span data-reveal="mask">Cómo trabajamos</span></span>
          <span class="line"><em class="italic" data-reveal="mask">juntos</em></span>
        </h2>
      </div>
      <p class="lead proc__intro reveal" data-reveal="fade">
        Cuatro etapas claras, sin sorpresas. Sabes en todo momento en qué punto está tu proyecto.
      </p>
    </header>

    <ul class="proc__steps" role="list">
      <span class="proc__rail" aria-hidden="true"><i data-proc-fill></i></span>
      {process.map((step) => (
        <li class="step reveal" data-reveal="card">
          <span class="step__dot" aria-hidden="true"></span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__copy">{step.copy}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proc { background: var(--surface); }

  .proc__h .line { display: block; overflow: hidden; padding-bottom: 0.05em; }
  .proc__h .line span, .proc__h .line em { display: block; }
  .proc__h em { color: var(--fg-dim); }

  .proc__intro { max-width: 36ch; text-align: right; }

  .proc__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 44px);
    padding-top: 40px;
  }

  .proc__rail {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
  }
  .proc__rail i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
  }

  .step {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: 4px;
  }

  .step__dot {
    position: absolute;
    top: -44px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--line-strong);
  }

  .step__title {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--fg);
    line-height: 1.15;
  }

  .step__copy {
    font-size: 14px;
    line-height: 1.72;
    color: var(--fg-muted);
  }

  @media (max-width: 900px) {
    .proc__intro { text-align: left; }
    .proc__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 44px; }
  }
  @media (max-width: 560px) {
    .proc__steps { grid-template-columns: 1fr; }
  }
</style>
