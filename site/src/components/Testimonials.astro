---
import { testimonials } from '../data/site';
---

<section class="section tst" aria-labelledby="tst-h">
  <div class="shell">
    <header class="section-head">
      <div>
        <p class="eyebrow reveal" data-reveal="fade">Clientes</p>
        <h2 id="tst-h" class="display tst__h">
          <span class="line"><span data-reveal="mask">Lo que dicen</span></span>
          <span class="line"><em class="italic" data-reveal="mask">de mi trabajo</em></span>
        </h2>
      </div>
      <span class="tst__rating reveal" data-reveal="fade">
        <span class="tst__stars" aria-label="Calificación máxima">★★★★★</span>
        <span class="caption">Calificación de mis clientes</span>
      </span>
    </header>

    <ul class="tst__grid" role="list">
      {testimonials.map((t, i) => (
        <li class="tst__card reveal" data-reveal="card">
          <a href={t.url} target="_blank" rel="noopener" class="tst__link" data-cursor="Ver">
            <span class="tst__quote" aria-hidden="true">”</span>
            <p class="tst__text">{t.quote}</p>
            <footer class="tst__foot">
              <span class="tst__brand">{t.brand}</span>
              <span class="tst__ig">
                Instagram
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </footer>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tst { background: var(--bg); }

  .tst__h .line { display: block; overflow: hidden; padding-bottom: 0.05em; }
  .tst__h .line span, .tst__h .line em { display: block; }
  .tst__h em { color: var(--fg-dim); }

  .tst__rating { display: grid; gap: 6px; justify-items: end; }
  .tst__stars { letter-spacing: 0.16em; font-size: 14px; color: var(--star); }

  .tst__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(14px, 1.8vw, 24px);
  }

  .tst__card { display: flex; }

  .tst__link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    padding: clamp(26px, 3vw, 40px);
    border: 1px solid var(--line);
    background: var(--surface);
    transition: background 0.5s var(--ease), border-color 0.5s var(--ease),
                transform 0.6s var(--ease);
  }
  .tst__link:hover {
    background: var(--surface-2);
    border-color: var(--line-strong);
    transform: translateY(-4px);
  }

  .tst__quote {
    font-family: var(--serif);
    font-size: 62px;
    line-height: 0.4;
    color: var(--fg-muted);
    opacity: 0.35;
    height: 22px;
  }

  .tst__text {
    font-family: var(--serif);
    font-size: clamp(1.02rem, 1.35vw, 1.22rem);
    line-height: 1.5;
    color: var(--fg-dim);
    flex: 1;
  }

  .tst__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .tst__brand {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .tst__ig {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: color 0.35s var(--ease);
  }
  .tst__link:hover .tst__ig { color: var(--fg); }

  @media (max-width: 720px) {
    .tst__rating { justify-items: start; }
  }
</style>
