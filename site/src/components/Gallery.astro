---
import { Image } from 'astro:assets';
import { filters } from '../data/projects';
import { site } from '../data/site';
import { buildCovers, buildGroups } from '../lib/shots';
import Lightbox from './Lightbox.tsx';

interface Props {
  /** 'full' = portafolio completo con filtros. 'preview' = selección para el inicio. */
  variant?: 'full' | 'preview';
  limit?: number;
  heading?: string;
}

const { variant = 'full', limit, heading } = Astro.props;

/* Una portada por proyecto: en la cuadrícula no se repite ningún producto. */
const allCovers = buildCovers();
const covers = limit ? allCovers.slice(0, limit) : allCovers;

/* Al grupo completo se accede desde el modal, donde sí se ven todas las fotos */
const groups = await buildGroups();
const visible = new Set(covers.map((c) => c.slug));

const isFull = variant === 'full';
---

<section class:list={['gal', { 'gal--preview': !isFull }]} id="galeria">
  <div class="shell">
    {!isFull && (
      <header class="section-head">
        <div>
          <p class="eyebrow reveal" data-reveal="fade">Selección</p>
          <h2 class="display gal__h">
            <span class="line"><span data-reveal="mask">{heading ?? 'Trabajo reciente'}</span></span>
          </h2>
        </div>
        <a href="/portafolio" class="btn btn--sm" data-cursor>
          Ver el portafolio completo
          <svg class="arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </header>
    )}

    {isFull && (
      <div class="gal__tools">
        <div class="gal__tabs" role="tablist" aria-label="Filtrar portafolio">
          {filters.map((f, i) => (
            <button
              class:list={['tab', { 'is-active': i === 0 }]}
              role="tab"
              type="button"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-filter={f.id}
              data-cursor
            >
              {f.label}
            </button>
          ))}
        </div>
        <p class="caption gal__count" aria-hidden="true">Toca una marca para ver toda la sesión</p>
      </div>
    )}

    <div class="gal__grid" id="gal-grid">
      {covers.map((cover, i) => {
        const group = groups.find((g) => g.slug === cover.slug)!;
        const extra = group.photos.length - 1;

        return (
          <figure
            class="shot reveal"
            data-shot={cover.slug}
            data-cat={cover.project.category}
            data-reveal="shot"
            data-cursor="Ver sesión"
          >
            <button
              class="shot__btn"
              type="button"
              aria-label={`Ver la sesión de ${cover.project.title}`}
            >
              <span class="shot__frame">
                <Image
                  src={cover.src}
                  alt={`${cover.project.title} — ${cover.project.categoryLabel}`}
                  widths={[420, 640, 880]}
                  sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 31vw"
                  format="webp"
                  quality={80}
                  loading={i < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />

                {extra > 0 && (
                  <span class="shot__more" aria-hidden="true">
                    <span class="shot__stack">
                      {Array.from({ length: Math.min(extra, 4) }).map(() => <i></i>)}
                    </span>
                    Ver sesión
                  </span>
                )}
              </span>

              <figcaption class="shot__cap">
                <span class="shot__title">{cover.project.title}</span>
                <span class="shot__dash" aria-hidden="true">—</span>
                <span class="shot__cat">{cover.project.categoryLabel}</span>
              </figcaption>
            </button>
          </figure>
        );
      })}
    </div>

    {isFull && (
      <>
        <p class="gal__empty caption" id="gal-empty" hidden>No hay proyectos en esta categoría.</p>

        <div class="gal__cta reveal" data-reveal="fade">
          <p class="gal__cta-txt">¿Quieres ver el portafolio completo?</p>
          <div class="gal__cta-btns">
            <a href={site.instagramUrl} target="_blank" rel="noopener" class="btn btn--solid" data-cursor>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.26.07 1.64.07 4.85s-.01 3.58-.07 4.85c-.15 3.22-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.15-3.23 1.66-4.77 4.92-4.92C8.42 2.17 8.8 2.16 12 2.16Zm0-2.16C8.74 0 8.33.01 7.05.07 2.69.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95C23.73 2.7 21.31.27 16.95.07 15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z" />
              </svg>
              Ver en Instagram
            </a>
            <a href={site.pdf} download class="btn" data-cursor>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M12 3v13m0 0-4-4m4 4 4-4M3 19h18" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Descargar portafolio PDF
            </a>
          </div>
        </div>
      </>
    )}
  </div>

  <Lightbox client:idle groups={groups.filter((g) => visible.has(g.slug))} />
</section>

<style>
  .gal {
    background: var(--bg);
    /* Menos margen lateral que el resto del sitio: aquí mandan las fotos */
    padding: clamp(36px, 5vh, 64px) clamp(16px, 2.4vw, 40px) clamp(56px, 9vh, 110px);
  }

  /* El mosaico llega más lejos que el ancho del resto de secciones */
  .gal .shell { max-width: 1840px; }

  .gal--preview { padding-top: var(--section-y); }

  .gal__h .line { display: block; overflow: hidden; padding-bottom: 0.05em; }
  .gal__h .line span { display: block; }

  .gal__tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: clamp(26px, 4vh, 44px);
  }

  .gal__tabs { display: flex; flex-wrap: wrap; gap: 8px; }

  /* ── Mosaico ── */
  .gal__grid {
    column-count: 3;
    /* Calles finas: las fotos casi se tocan, como en la referencia */
    column-gap: clamp(8px, 0.7vw, 13px);
  }

  .shot {
    break-inside: avoid;
    margin: 0 0 clamp(24px, 2.2vw, 36px);
    display: block;
  }
  .shot[hidden] { display: none; }

  .shot__btn { display: block; width: 100%; text-align: left; padding: 0; }

  .shot__frame {
    display: block;
    overflow: hidden;
    background: var(--surface-2);
    position: relative;
  }
  .shot__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 6, 6, 0.55) 0%, transparent 42%);
    opacity: 0;
    transition: opacity 0.55s var(--ease);
    pointer-events: none;
  }
  .shot__frame :global(img) {
    width: 100%;
    height: auto;
    transition: transform 1.1s var(--ease);
  }
  .shot__btn:hover .shot__frame :global(img) { transform: scale(1.045); }
  .shot__btn:hover .shot__frame::after { opacity: 1; }

  /* Aviso de que detrás hay más fotos de la misma sesión */
  .shot__more {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f5f0e8;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.45s var(--ease), transform 0.55s var(--ease);
  }
  .shot__btn:hover .shot__more { opacity: 1; transform: none; }

  .shot__stack { display: flex; gap: 3px; }
  .shot__stack i {
    width: 9px;
    height: 12px;
    border: 1px solid rgba(245, 240, 232, 0.75);
  }

  .shot__cap {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-top: 13px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .shot__title {
    color: var(--fg-dim);
    transition: color 0.35s var(--ease);
  }
  .shot__btn:hover .shot__title { color: var(--fg); }
  .shot__dash,
  .shot__cat { color: var(--fg-muted); }

  .gal__empty { text-align: center; padding-block: 60px; }

  /* ── CTA ── */
  .gal__cta {
    margin-top: clamp(16px, 3vh, 32px);
    padding-top: clamp(32px, 5vh, 56px);
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .gal__cta-txt {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    color: var(--fg);
  }
  .gal__cta-btns { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 1100px) { .gal__grid { column-count: 2; } }
  @media (max-width: 640px) {
    .gal__grid { column-count: 1; }
    .shot { margin-bottom: 30px; }
    .gal__cta-btns .btn { flex: 1 1 auto; justify-content: center; }
    .gal__count { display: none; }
  }
</style>
