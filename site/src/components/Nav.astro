---
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="nav" id="nav">
  <div class="nav__bar shell">
    <a href="/" class="nav__logo" aria-label={`${site.name} — inicio`} data-cursor>
      <img src="/logo-blanco.png" alt="" class="nav__logo-img nav__logo-img--dark" width="160" height="48" />
      <img src="/logo-negro.png" alt="" class="nav__logo-img nav__logo-img--light" width="160" height="48" />
    </a>

    <nav class="nav__links" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav__link', { 'is-active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-cursor
        >
          <span class="nav__link-txt">{item.label}</span>
          <span class="nav__link-txt nav__link-txt--dup" aria-hidden="true">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="nav__right">
      <button class="nav__theme" id="theme-toggle" type="button" aria-label="Cambiar tema" data-cursor>
        <svg class="ico ico--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2v2.4M12 19.6V22M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2 12h2.4M19.6 12H22M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7" stroke-linecap="round" />
        </svg>
        <svg class="ico ico--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z" stroke-linejoin="round" />
        </svg>
      </button>

      <a href={site.wa('Hola Agustín, me interesa conocer más sobre tus servicios fotográficos.')}
         target="_blank" rel="noopener" class="btn btn--sm nav__cta" data-cursor>
        Hablemos
      </a>

      <button class="nav__burger" id="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" hidden>
  <div class="menu__inner">
    <nav class="menu__links" aria-label="Menú móvil">
      <a href="/" class:list={['menu__link', { 'is-active': path === '/' }]} data-menu-item>
        <span class="menu__tick" aria-hidden="true"></span>
        <span class="display">Inicio</span>
      </a>
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['menu__link', { 'is-active': isActive(item.href) }]}
          data-menu-item
        >
          <span class="menu__tick" aria-hidden="true"></span>
          <span class="display">{item.label}</span>
        </a>
      ))}
    </nav>
    <div class="menu__foot" data-menu-item>
      <a href={`mailto:${site.email}`} class="link-u">{site.email}</a>
      <a href={site.instagramUrl} target="_blank" rel="noopener" class="link-u">@{site.instagram}</a>
      <a href={`tel:+${site.phoneIntl}`} class="link-u">{site.phone}</a>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 500;
    padding: 0 var(--pad-x);
    transition: background 0.5s var(--ease), backdrop-filter 0.5s var(--ease),
                border-color 0.5s var(--ease), transform 0.6s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .nav.is-stuck {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: var(--line);
  }

  .nav.is-hidden { transform: translateY(-102%); }

  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 22px;
    transition: padding 0.5s var(--ease);
  }

  .nav.is-stuck .nav__bar { padding-block: 14px; }

  .nav__logo-img {
    height: 42px;
    width: auto;
    transition: height 0.5s var(--ease);
  }
  .nav.is-stuck .nav__logo-img { height: 34px; }

  :root[data-theme='dark'] .nav__logo-img--light,
  :root:not([data-theme='light']) .nav__logo-img--light { display: none; }
  :root[data-theme='light'] .nav__logo-img--dark { display: none; }

  .nav__links { display: flex; gap: clamp(18px, 2.6vw, 40px); }

  .nav__link {
    position: relative;
    overflow: hidden;
    height: 1.2em;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .nav__link-txt {
    display: block;
    transition: transform 0.5s var(--ease);
  }
  .nav__link-txt--dup {
    position: absolute;
    inset: 0;
    color: var(--fg);
  }
  .nav__link:hover .nav__link-txt { transform: translateY(-100%); }

  .nav__link.is-active { color: var(--fg); }
  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--fg);
  }

  .nav__right { display: flex; align-items: center; gap: 14px; }

  .nav__theme {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--fg-dim);
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease), transform 0.5s var(--ease);
  }
  .nav__theme:hover { color: var(--fg); border-color: var(--line-strong); transform: rotate(35deg); }
  .nav__theme .ico { grid-area: 1 / 1; transition: opacity 0.3s var(--ease), transform 0.4s var(--ease); }

  :root[data-theme='light'] .ico--sun { opacity: 0; transform: scale(0.6); }
  :root:not([data-theme='light']) .ico--moon { opacity: 0; transform: scale(0.6); }

  .nav__burger {
    display: none;
    position: relative;
    width: 38px;
    height: 38px;
    place-items: center;
  }
  .nav__burger span {
    position: absolute;
    left: 9px;
    top: 50%;
    width: 20px;
    height: 1px;
    background: var(--fg);
    transition: transform 0.45s var(--ease);
  }
  .nav__burger span:nth-child(1) { transform: translateY(-3.5px); }
  .nav__burger span:nth-child(2) { transform: translateY(3.5px); }
  .nav__burger.is-open span:nth-child(1) { transform: rotate(45deg); }
  .nav__burger.is-open span:nth-child(2) { transform: rotate(-45deg); }

  /* ── Menú móvil ── */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 480;
    background: var(--bg);
    display: grid;
    align-content: center;
    padding: 120px var(--pad-x) 48px;
    clip-path: inset(0 0 100% 0);
  }
  .menu[hidden] { display: none; }

  .menu__links { display: grid; gap: 6px; }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.9rem, 8.5vw, 3.4rem);
    font-family: var(--serif);
    color: var(--fg-muted);
    transition: padding-left 0.5s var(--ease), color 0.3s var(--ease);
  }
  .menu__link:hover { padding-left: 14px; color: var(--fg); }
  .menu__link.is-active { color: var(--fg); }

  .menu__tick {
    width: 16px;
    height: 1px;
    background: var(--line-strong);
    flex: 0 0 auto;
    align-self: center;
    transition: width 0.5s var(--ease), background 0.4s var(--ease);
  }
  .menu__link:hover .menu__tick,
  .menu__link.is-active .menu__tick { width: 26px; background: var(--fg); }

  .menu__foot {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-size: 13px;
    color: var(--fg-dim);
  }

  @media (max-width: 980px) {
    .nav__links, .nav__cta { display: none; }
    .nav__burger { display: grid; }
  }
</style>
