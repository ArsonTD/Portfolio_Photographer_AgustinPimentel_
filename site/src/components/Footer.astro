---
import { site, nav } from '../data/site';
---

<footer class="ft">
  <div class="shell">
    <div class="ft__mark" aria-hidden="true">
      <span class="display" data-reveal="mask">Agustín Pimentel</span>
    </div>

    <div class="ft__grid">
      <div class="ft__col">
        <span class="caption">Navegación</span>
        <ul role="list">
          {nav.map((n) => (
            <li><a href={n.href} class="link-u" data-cursor>{n.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="ft__col">
        <span class="caption">Contacto</span>
        <ul role="list">
          <li><a href={`https://wa.me/${site.phoneIntl}`} target="_blank" rel="noopener" class="link-u" data-cursor>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`} class="link-u" data-cursor>{site.email}</a></li>
          <li><a href={site.instagramUrl} target="_blank" rel="noopener" class="link-u" data-cursor>@{site.instagram}</a></li>
        </ul>
      </div>

      <div class="ft__col">
        <span class="caption">Servicios</span>
        <ul role="list">
          <li>Fotografía gastronómica</li>
          <li>Fotografía de producto</li>
          <li>Fotografía de joyería</li>
        </ul>
      </div>

      <div class="ft__col ft__col--end">
        <span class="caption">Base</span>
        <p class="ft__loc">{site.location}<br />Disponible para viajar</p>
        <a href={site.pdf} download class="btn btn--sm" data-cursor>Portafolio PDF</a>
      </div>
    </div>

    <div class="ft__bar">
      <p class="caption">© {site.name} · Fotografía comercial</p>
      <div class="ft__bar-r">
        <a href="/privacidad" class="caption link-u" data-cursor>Política de privacidad</a>
        <button type="button" id="to-top" class="ft__top" data-cursor aria-label="Volver arriba">
          <span class="caption">Arriba</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 19V5M6 11l6-6 6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<a
  href={site.wa('Hola Agustín, vengo desde tu web y quiero cotizar una sesión.')}
  target="_blank"
  rel="noopener"
  class="wa"
  id="wa-float"
  aria-label="Escribir por WhatsApp"
  data-cursor
>
  <span class="wa__ring" aria-hidden="true"></span>
  <span class="wa__core">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.01-1.04 2.48 1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.57-.34ZM12.05 21.8h-.01a9.8 9.8 0 0 1-4.99-1.37l-.36-.21-3.7.97.99-3.61-.24-.37a9.79 9.79 0 0 1-1.5-5.22c0-5.4 4.4-9.8 9.82-9.8 2.62 0 5.08 1.03 6.93 2.88a9.74 9.74 0 0 1 2.87 6.93c0 5.4-4.4 9.8-9.81 9.8Zm8.35-18.15A11.72 11.72 0 0 0 12.05 0C5.56 0 .28 5.28.28 11.77c0 2.07.54 4.1 1.57 5.88L.18 24l6.5-1.7a11.73 11.73 0 0 0 5.37 1.36h.01c6.48 0 11.76-5.28 11.77-11.77 0-3.15-1.23-6.1-3.45-8.33Z" />
  </svg>
  </span>
</a>

<style>
  .ft {
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding: clamp(56px, 8vh, 96px) var(--pad-x) clamp(24px, 3vh, 34px);
    overflow: hidden;
  }

  .ft__mark {
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: clamp(36px, 5vh, 64px);
    border-bottom: 1px solid var(--line);
  }
  .ft__mark span {
    display: block;
    font-size: clamp(2.4rem, 11.5vw, 11rem);
    line-height: 0.86;
    letter-spacing: -0.035em;
    color: var(--fg);
    white-space: nowrap;
  }

  .ft__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
    padding-bottom: clamp(36px, 5vh, 60px);
  }

  .ft__col { display: grid; gap: 14px; align-content: start; }
  .ft__col ul { display: grid; gap: 9px; }
  .ft__col li, .ft__loc {
    font-size: 14px;
    color: var(--fg-dim);
    line-height: 1.6;
  }
  .ft__col--end { justify-items: start; }

  .ft__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .ft__bar-r { display: flex; align-items: center; gap: 26px; }

  .ft__top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-muted);
    transition: color 0.3s var(--ease);
  }
  .ft__top:hover { color: var(--fg); }
  .ft__top svg { transition: transform 0.45s var(--ease); }
  .ft__top:hover svg { transform: translateY(-3px); }

  /* Botón flotante de WhatsApp.
     La entrada y el hover viven en el <a>; el latido va en .wa__core y el
     halo en .wa__ring, así ninguna transformación pisa a la otra. */
  .wa {
    position: fixed;
    right: clamp(16px, 2.4vw, 30px);
    bottom: clamp(16px, 2.4vw, 30px);
    z-index: 400;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
    transition: transform 0.5s var(--ease), opacity 0.4s var(--ease);
  }
  .wa.is-in { opacity: 1; transform: none; pointer-events: auto; }
  .wa:hover { transform: scale(1.06); }

  .wa__core,
  .wa__ring { grid-area: 1 / 1; border-radius: 50%; }

  .wa__core {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    background: #25d366;
    color: #08130c;
    box-shadow: 0 14px 34px -12px rgba(37, 211, 102, 0.7);
    animation: wa-beat 2.6s var(--ease-in-out) infinite;
    transition: box-shadow 0.4s var(--ease);
  }
  .wa:hover .wa__core {
    box-shadow: 0 18px 40px -12px rgba(37, 211, 102, 0.9);
    animation-play-state: paused;
  }

  /* Dos ondas desfasadas, sincronizadas con el doble golpe del latido */
  .wa__ring { width: 54px; height: 54px; pointer-events: none; }
  .wa__ring::before,
  .wa__ring::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid #25d366;
    opacity: 0;
    animation: wa-ripple 2.6s var(--ease) infinite;
  }
  .wa__ring::after { animation-delay: 0.22s; }
  .wa:hover .wa__ring::before,
  .wa:hover .wa__ring::after { animation-play-state: paused; }

  /* lub-dub y descanso */
  @keyframes wa-beat {
    0%, 100% { transform: scale(1); }
    8%       { transform: scale(1.13); }
    16%      { transform: scale(1); }
    24%      { transform: scale(1.09); }
    34%      { transform: scale(1); }
  }

  @keyframes wa-ripple {
    0%   { transform: scale(1); opacity: 0.6; }
    60%  { opacity: 0; }
    100% { transform: scale(2); opacity: 0; }
  }

  @media (max-width: 900px) {
    .ft__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 34px; }
  }
  @media (max-width: 520px) {
    .ft__bar-r { width: 100%; justify-content: space-between; }
  }
</style>
