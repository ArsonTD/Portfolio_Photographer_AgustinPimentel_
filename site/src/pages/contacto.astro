---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
---

<Base
  title={`Contacto — ${site.name} | Fotógrafo comercial RD`}
  description="Escríbeme por WhatsApp o correo y hablamos de tu proyecto de fotografía comercial."
>
  <PageHeader
    eyebrow="Contacto"
    title="Contemos tu"
    accent="historia"
    lead="Cuéntame tu proyecto y te respondo rápido — normalmente el mismo día."
  />

  <Contact />
</Base>
